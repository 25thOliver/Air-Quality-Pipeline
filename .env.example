# Kafka
BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=air_quality_data
FETCH_INTERVAL=3600

# Open-Meteo API
OPEN_METEO_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# City coordinates (Kenya defaults)
NAIROBI_LAT=-1.286389
NAIROBI_LON=36.817223
MOMBASA_LAT=-4.0435
MOMBASA_LON=39.6682

# MongoDB — use a strong, randomly generated password in production
# Generate one with: openssl rand -base64 24
MONGO_URI=mongodb://app_user:your_password_here@mongo:27017/air_quality_db?authSource=admin
MONGO_DB=air_quality_db
MONGO_COLLECTION=air_quality_raw

# Cassandra CDC consumer
# Note: must be lowercase — Docker DNS is case-sensitive on Linux
CDC_TOPIC=mongo_cdc.air_quality_db.air_quality_raw
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=air_quality_analytics
